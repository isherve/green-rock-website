{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --prefix backend && npm ci --prefix frontend",
  "buildCommand": "npm run vercel:deploy --prefix backend && npm run build --prefix frontend",
  "outputDirectory": "frontend/.next",
  "devCommand": "npm run dev --prefix frontend",
  "rewrites": [
    { "source": "/health", "destination": "/api/server" },
    { "source": "/api/docs", "destination": "/api/server" },
    { "source": "/api/docs.json", "destination": "/api/server" },
    { "source": "/api/setup/(.*)", "destination": "/api/server" },
    { "source": "/api/(.*)", "destination": "/api/server" }
  ],
  "functions": {
    "api/server.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "backend/src/**, backend/node_modules/.prisma/**, backend/node_modules/@prisma/**"
    }
  }
}
