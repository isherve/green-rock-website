{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "dist/app.js"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/docs",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/docs.json",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/setup/(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "type": "service", "service": "frontend" }
    }
  ]
}
